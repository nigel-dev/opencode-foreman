{
  "name": "@nigel-dev/opencode-foreman",
  "version": "0.1.0",
  "description": "OpenCode plugin that ships a team of agents with configurable models, keeps them working until the job is verified, and screens routine permission prompts with a decision model",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "foreman.example.jsonc"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "release": "semantic-release",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/plugin": "2.3.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.15.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "author": "Nigel Bazzeghin <nbazzeghin@gmail.com>",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "decision-model",
    "jev"
  ],
  "homepage": "https://github.com/nigel-dev/opencode-foreman#readme",
  "bugs": {
    "url": "https://github.com/nigel-dev/opencode-foreman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nigel-dev/opencode-foreman.git"
  }
}
